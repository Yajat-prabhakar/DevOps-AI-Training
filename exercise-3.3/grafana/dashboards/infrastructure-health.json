      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "infra:health_score_overall:score",
          "legendFormat": "Overall",
          "refId": "A"
        },
        {
          "expr": "infra:cpu_health:score",
          "legendFormat": "CPU",
