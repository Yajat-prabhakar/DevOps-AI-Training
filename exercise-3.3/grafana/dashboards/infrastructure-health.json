        },
        {
          "expr": "infra:memory_health:score",
          "legendFormat": "Memory",
          "refId": "C"
        },
        {
          "expr": "infra:disk_health:score",
          "legendFormat": "Disk",
          "refId": "D"
        },
        {
          "expr": "infra:network_health:score",
          "legendFormat": "Network",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Disk Usage Prediction",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "infra:disk_usage:current * 100",
          "legendFormat": "Current Usage",
          "refId": "A"
        },
        {
          "expr": "predict_linear(node_filesystem_avail_bytes[6h], 24 * 3600) / node_filesystem_size_bytes * 100",
          "legendFormat": "Predicted (24h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "title": "Days Until Disk Exhaustion",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "infra:disk_exhaustion:days_until",
          "legendFormat": "Days Until Exhaustion",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "title": "CPU Utilization Prediction",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "infra:cpu_utilization:current * 100",
          "legendFormat": "Current Utilization",
          "refId": "A"
        },
        {
          "expr": "predict_linear(infra:cpu_utilization:current[1h], 3600) * 100",
          "legendFormat": "Predicted (1h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "title": "Memory Utilization Prediction",
