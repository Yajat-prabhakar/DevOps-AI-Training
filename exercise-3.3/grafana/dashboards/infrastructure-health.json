      "targets": [
        {
          "expr": "infra:memory_utilization:current * 100",
          "legendFormat": "Current Utilization",
          "refId": "A"
        },
        {
          "expr": "predict_linear(infra:memory_utilization:current[1h], 4 * 3600) * 100",
          "legendFormat": "Predicted (4h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          }
        }
      }
    },
