{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Executive Health Scoring Dashboard - Exercise 3.1",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Overall Infrastructure Health",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(node:health_score_overall:score)",
          "legendFormat": "Overall Health",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "CPU Health Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(node:health_score_cpu:score)",
          "legendFormat": "CPU Health",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Memory Health Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(node:health_score_memory:score)",
          "legendFormat": "Memory Health",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Health Score Trend (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "node:health_score_overall:score",
          "legendFormat": "Overall {{instance}}",
          "refId": "A"
        },
        {
          "expr": "node:health_score_cpu:score",
          "legendFormat": "CPU {{instance}}",
          "refId": "B"
        },
        {
          "expr": "node:health_score_memory:score",
          "legendFormat": "Memory {{instance}}",
          "refId": "C"
        },
        {
          "expr": "node:health_score_disk:score",
          "legendFormat": "Disk {{instance}}",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Active Anomalies by Type",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\",service=\"cpu\"})",
          "legendFormat": "CPU",
          "refId": "A"
        },
        {
          "expr": "count(ALERTS{alertstate=\"firing\",service=\"memory\"})",
          "legendFormat": "Memory",
          "refId": "B"
        },
        {
          "expr": "count(ALERTS{alertstate=\"firing\",service=\"disk\"})",
          "legendFormat": "Disk",
          "refId": "C"
        },
        {
          "expr": "count(ALERTS{alertstate=\"firing\",service=\"network\"})",
          "legendFormat": "Network",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Anomaly Score Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "node:cpu_anomaly_score:zscore",
          "legendFormat": "CPU",
          "refId": "A"
        },
        {
          "expr": "node:memory_anomaly_score:zscore",
          "legendFormat": "Memory",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Firing Alerts Summary",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"})",
          "legendFormat": "Total Firing",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "Resource Utilization Forecast",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "predict_linear(node:cpu_usage_rate:avg5m[1h], 3600)",
          "legendFormat": "CPU (predicted 1h)",
          "refId": "A"
        },
        {
          "expr": "predict_linear(node:memory_usage_rate:avg5m[1h], 3600)",
          "legendFormat": "Memory (predicted 1h)",
          "refId": "B"
        },
        {
          "expr": "predict_linear(node:disk_usage_rate:avg5m[1h], 3600 * 24)",
          "legendFormat": "Disk (predicted 24h)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "title": "Capacity Planning Alerts",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "ALERTS{category=\"prediction\"}",
          "legendFormat": "{{alertname}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        }
      }
    },
    {
      "title": "Infrastructure Health by Instance",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "node:health_score_overall:score",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          },
          "custom": {
            "align": "auto"
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 32,
  "style": "dark",
  "tags": ["health", "executive", "monitoring"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "title": "Executive Health Scoring Dashboard",
  "uid": "health-scoring-001",
  "version": 1
}
